# =============================================================================
# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os
# caminhos reais do SEU computador. O arquivo .env nunca deve ser commitado
# (ja esta listado no .gitignore) — ele contem caminhos internos da empresa.
# =============================================================================

# Caminho absoluto e completo da planilha principal (.xlsx ou .xlsm)
PLANILHA_PATH=C:\Caminho\Para\Sua\Pasta\Sincronizada\planilha.xlsm

# Nome exato da aba com os dados (opcional, padrao: "tecnico")
PLANILHA_ABA=tecnico

# Porta do servidor local (opcional, padrao: 5000)
SERVER_PORT=5000

# -----------------------------------------------------------------------------
# Levantamento por municipio — planilhas em <BASE>/<MUNICIPIO>/AUDITORIA/
# -----------------------------------------------------------------------------

# Base do ano atual (obrigatoria)
LEVANTAMENTOS_BASE_PATH=C:\Caminho\Para\Sua\Pasta\Sincronizada\2026\Municipios

# Bases de anos anteriores (opcionais — deixe em branco ou remova a linha
# se nao existir esse ano)
LEVANTAMENTOS_BASE_PATH_2025=C:\Caminho\Para\Sua\Pasta\Sincronizada\2025\Municipios
LEVANTAMENTOS_BASE_PATH_2024=C:\Caminho\Para\Sua\Pasta\Sincronizada\2024\Municipios

# Prefixo do nome do arquivo de levantamento dentro de AUDITORIA/
# (opcional, padrao: "FECHAMENTO")
LEVANTAMENTO_ARQUIVO_PREFIXO=FECHAMENTO

# -----------------------------------------------------------------------------
# Transformadores (KML) e areas inacessiveis (GPKG) — opcionais
# -----------------------------------------------------------------------------
TRANSFORMADORES_BASE_PATH=C:\Caminho\Para\Sua\Pasta\Sincronizada\2026\INTERNO_ANALISE
AREAS_INACESSIVEIS_BASE_PATH=C:\Caminho\Para\Sua\Pasta\Sincronizada\2026\INTERNO_ANALISE
