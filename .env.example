# =============================================================================
# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os
# caminhos reais. O arquivo .env nunca deve ser commitado (ja esta listado
# no .gitignore) — ele contem caminhos internos da empresa.
#
# IMPORTANTE: nas variaveis de CAMINHO abaixo, NAO inclua "C:\Users\<usuario>".
# O sistema detecta o usuario do Windows automaticamente e monta o caminho
# completo sozinho. Coloque so o trecho que vem DEPOIS do usuario, comecando
# com "\". Assim o mesmo .env funciona em qualquer computador da equipe.
#
#   Caminho real:  C:\Users\joao\OneDrive - Empresa\Portal\planilha.xlsm
#   O que vai aqui:                \OneDrive - Empresa\Portal\planilha.xlsm
# =============================================================================

# Caminho da planilha principal (.xlsx ou .xlsm), sem o "C:\Users\<usuario>"
PLANILHA_PATH=\Caminho\Da\Sua\Pasta\Sincronizada\planilha.xlsm

# Nome exato da aba com os dados (opcional, padrao: "tecnico")
PLANILHA_ABA=tecnico

# Porta do servidor local (opcional, padrao: 5000)
SERVER_PORT=5000

# -----------------------------------------------------------------------------
# Levantamento por municipio — planilhas em <BASE>/<MUNICIPIO>/<SUBPASTA>/
# (nome da subpasta definido abaixo, em LEVANTAMENTO_SUBPASTA)
# -----------------------------------------------------------------------------

# Base do ano atual (obrigatoria), sem o "C:\Users\<usuario>"
LEVANTAMENTOS_BASE_PATH=\Caminho\Da\Sua\Pasta\Sincronizada\2026\Municipios

# Bases de anos anteriores (opcionais — deixe em branco ou remova a linha
# se nao existir esse ano)
LEVANTAMENTOS_BASE_PATH_2025=\Caminho\Da\Sua\Pasta\Sincronizada\2025\Municipios
LEVANTAMENTOS_BASE_PATH_2024=\Caminho\Da\Sua\Pasta\Sincronizada\2024\Municipios

# Prefixo do nome do arquivo de levantamento dentro da subpasta (ver abaixo)
# (opcional, padrao: "FECHAMENTO")
LEVANTAMENTO_ARQUIVO_PREFIXO=FECHAMENTO

# Subpasta padrao e subpasta prioritaria, dentro de <BASE>/<MUNICIPIO>/.
# Se a subpasta prioritaria existir com uma planilha valida (contendo a
# folha obrigatoria LEVANTAMENTO_ABA), ela e usada no lugar da padrao.
LEVANTAMENTO_SUBPASTA=NOME_DA_SUBPASTA_PADRAO
LEVANTAMENTO_SUBPASTA_PRIORITARIA=NOME_DA_SUBPASTA_PRIORITARIA

# Nome exato da folha obrigatoria (sempre usada)
LEVANTAMENTO_ABA=NOME_DA_FOLHA_OBRIGATORIA

# Folhas extras, presentes so na planilha da subpasta prioritaria. Cada uma
# vira uma categoria de pontos no mapa, na ordem listada. Separadas por "|".
# Deixe em branco se nao houver subpasta prioritaria.
LEVANTAMENTO_ABAS_EXTRAS=FOLHA_A|FOLHA_B|FOLHA_C

# Qual das folhas extras acima tem pontos que TAMBEM existem na folha
# obrigatoria (mesmo ID) e devem SOBREPOR o ponto correspondente quando a
# categoria e marcada. Deixe em branco se nao houver esse caso.
LEVANTAMENTO_ABA_SOBREPOSTA=FOLHA_A

# Par origem/alvo usado para calcular uma categoria derivada "origem + alvo":
# pontos da folha origem cujo circuito (coluna MEDIDOR_NC) nao existe na
# folha alvo. Deixe ambos em branco se nao houver esse caso.
LEVANTAMENTO_ABA_CIRCUITO_ORIGEM=FOLHA_B
LEVANTAMENTO_ABA_CIRCUITO_ALVO=FOLHA_C

# -----------------------------------------------------------------------------
# Transformadores (KML) e areas inacessiveis (GPKG) — opcionais
# sem o "C:\Users\<usuario>"
# -----------------------------------------------------------------------------
TRANSFORMADORES_BASE_PATH=\Caminho\Da\Sua\Pasta\Sincronizada\2026\INTERNO_ANALISE
AREAS_INACESSIVEIS_BASE_PATH=\Caminho\Da\Sua\Pasta\Sincronizada\2026\INTERNO_ANALISE

# Subpastas dentro de <TRANSFORMADORES_BASE_PATH|AREAS_INACESSIVEIS_BASE_PATH>/<MUNICIPIO>/
TRANSFORMADORES_SUBPASTA=NOME_DA_SUBPASTA_DE_KML
AREAS_INACESSIVEIS_SUBPASTA=NOME_DA_SUBPASTA_DE_GPKG
