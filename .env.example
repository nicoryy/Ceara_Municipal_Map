# =============================================================================
# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os
# caminhos reais. O arquivo .env nunca deve ser commitado (ja esta listado
# no .gitignore) — ele contem caminhos internos da empresa.
#
# IMPORTANTE: nas variaveis de CAMINHO abaixo, NAO inclua "C:\Users\<usuario>".
# O sistema detecta o usuario do Windows automaticamente e monta o caminho
# completo sozinho. Coloque so o trecho que vem DEPOIS do usuario, comecando
# com "\". Assim o mesmo .env funciona em qualquer computador da equipe.
#
#   Caminho real:  C:\Users\joao\OneDrive - Empresa\Portal\planilha.xlsm
#   O que vai aqui:                \OneDrive - Empresa\Portal\planilha.xlsm
# =============================================================================

# Caminho da planilha principal (.xlsx ou .xlsm), sem o "C:\Users\<usuario>"
PLANILHA_PATH=\Caminho\Da\Sua\Pasta\Sincronizada\planilha.xlsm

# Nome exato da aba com os dados (opcional, padrao: "tecnico")
PLANILHA_ABA=tecnico

# Porta do servidor local (opcional, padrao: 5000)
SERVER_PORT=5000

# -----------------------------------------------------------------------------
# Levantamento por municipio — planilhas em <BASE>/<MUNICIPIO>/AUDITORIA/
# -----------------------------------------------------------------------------

# Base do ano atual (obrigatoria), sem o "C:\Users\<usuario>"
LEVANTAMENTOS_BASE_PATH=\Caminho\Da\Sua\Pasta\Sincronizada\2026\Municipios

# Bases de anos anteriores (opcionais — deixe em branco ou remova a linha
# se nao existir esse ano)
LEVANTAMENTOS_BASE_PATH_2025=\Caminho\Da\Sua\Pasta\Sincronizada\2025\Municipios
LEVANTAMENTOS_BASE_PATH_2024=\Caminho\Da\Sua\Pasta\Sincronizada\2024\Municipios

# Prefixo do nome do arquivo de levantamento dentro de AUDITORIA/
# (opcional, padrao: "FECHAMENTO")
LEVANTAMENTO_ARQUIVO_PREFIXO=FECHAMENTO

# -----------------------------------------------------------------------------
# Transformadores (KML) e areas inacessiveis (GPKG) — opcionais
# sem o "C:\Users\<usuario>"
# -----------------------------------------------------------------------------
TRANSFORMADORES_BASE_PATH=\Caminho\Da\Sua\Pasta\Sincronizada\2026\INTERNO_ANALISE
AREAS_INACESSIVEIS_BASE_PATH=\Caminho\Da\Sua\Pasta\Sincronizada\2026\INTERNO_ANALISE
